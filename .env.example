SEPOLIA_RPC_URL=https://replace.example.invalid
BASE_SEPOLIA_RPC_URL=https://replace.example.invalid
DEPLOYER_PRIVATE_KEY=0xREPLACE_WITH_A_DEDICATED_TESTNET_KEY

# Read-only public dashboard configuration (VitePress / GitHub Pages)
VITE_RECOVERY_RPC_URL=https://replace-with-public-read-only-rpc.example
VITE_RECOVERY_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_JPYC_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TAMAGAKI_SBT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_RECOVERY_DEPLOYMENT_BLOCK=0
VITE_JPYC_DECIMALS=18
VITE_TAMAGAKI_METADATA_VERSION=2

# Optional second demo network. Base Sepolia appears in the selector only after
# Vault, MockJPYC, and Tamagaki SBT addresses are all configured.
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
VITE_BASE_SEPOLIA_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_BASE_SEPOLIA_JPYC_ADDRESS=0x0000000000000000000000000000000000000000
VITE_BASE_SEPOLIA_TAMAGAKI_SBT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_BASE_SEPOLIA_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_BASE_SEPOLIA_COUNCIL_ADDRESS=0x0000000000000000000000000000000000000000
VITE_BASE_SEPOLIA_DEPLOYMENT_BLOCK=0
VITE_BASE_SEPOLIA_JPYC_DECIMALS=18
VITE_BASE_SEPOLIA_TAMAGAKI_METADATA_VERSION=2
VITE_RECOVERY_DEFAULT_NETWORK=sepolia
